# Copy to .env.local and fill in real values. .env / .env.local are git-ignored.

# --- Database (matches docker-compose.yml) ---
DB_URL=jdbc:postgresql://localhost:5437/hr
DB_USERNAME=hr
DB_PASSWORD=hr
DB_POOL_SIZE=10

# --- Server ---
SERVER_PORT=8091
LOG_LEVEL_APP=INFO

# --- Security ---
# HS256 signing secret, at least 32 bytes. Generate one per environment, e.g.
#   openssl rand -base64 48
# Required: the app (and `docker compose --profile app`) refuses to start without it.
JWT_SECRET=
JWT_EXPIRATION=PT8H

# --- Bootstrap administrator ---
# Seeded at startup only when the database contains no ADMIN yet AND HR_ADMIN_PASSWORD is
# set (there is no default). The seeded admin must change the password on first login.
HR_ADMIN_EMAIL=admin@hr.local
HR_ADMIN_PASSWORD=

# --- Login throttling (in-memory, per e-mail + client IP) ---
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW=PT15M

# --- API docs ---
# Swagger UI / /v3/api-docs are disabled unless true. Enable for local development only.
SPRINGDOC_ENABLED=false

