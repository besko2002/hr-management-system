# Copy to .env.local and fill in real values. .env / .env.local are git-ignored.

# --- Database (matches docker-compose.yml) ---
DB_URL=jdbc:postgresql://localhost:5437/hr
DB_USERNAME=hr
DB_PASSWORD=hr
DB_POOL_SIZE=10

# --- Server ---
SERVER_PORT=8091
LOG_LEVEL_APP=INFO

# --- Security ---
# HS256 signing secret, at least 32 bytes. Generate one per environment, e.g.
#   openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION=PT8H

# --- Bootstrap administrator ---
# Seeded at startup only when the database contains no ADMIN yet.
# The defaults (admin@hr.local / Admin@12345) are for local development ONLY.
HR_ADMIN_EMAIL=admin@hr.local
HR_ADMIN_PASSWORD=Admin@12345
